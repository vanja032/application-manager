QMainWindow,
QWidget#centralWidget,
QWidget#contentPanel {
    background: #171B22;
}

QWidget#searchRow,
QWidget#filterRow,
QWidget#sourceColumn,
QWidget#pageList,
QWidget#pageSettings,
QWidget#pageAbout,
QWidget#appListContainer,
QStackedWidget#pages,
QScrollArea#appScrollArea {
    background: transparent;
    border: none;
}

QFrame#sidebar {
    background: #1C212B;
    border: none;
    border-right: 1px solid #2C3340;
}

QLabel#brandTitle,
QLabel#brandSubtitle {
    color: #F3F5F8;
    font-size: 15px;
    font-weight: 700;
}

QLabel#darkModeLabel {
    color: #D5DBE3;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#discoverButton,
QPushButton#installedButton,
QPushButton#updatesButton,
QPushButton#settingsButton,
QPushButton#aboutButton {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #D5DBE3;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    padding: 0;
    min-height: 40px;
}

QPushButton#discoverButton QLabel#navText,
QPushButton#installedButton QLabel#navText,
QPushButton#updatesButton QLabel#navText,
QPushButton#settingsButton QLabel#navText,
QPushButton#aboutButton QLabel#navText,
QLabel#darkModeLabel {
    color: #D5DBE3;
    font-size: 14px;
    font-weight: 500;
    background: transparent;
    padding: 0;
    margin: 0;
}

QLabel#navIcon,
QLabel#darkModeIcon {
    background: transparent;
    padding: 0;
    margin: 0;
}

QPushButton#discoverButton:hover,
QPushButton#installedButton:hover,
QPushButton#updatesButton:hover,
QPushButton#settingsButton:hover,
QPushButton#aboutButton:hover {
    background: #262C38;
}

QPushButton#discoverButton:checked,
QPushButton#installedButton:checked,
QPushButton#updatesButton:checked,
QPushButton#settingsButton:checked,
QPushButton#aboutButton:checked,
QPushButton#discoverButton:checked:hover,
QPushButton#installedButton:checked:hover,
QPushButton#updatesButton:checked:hover,
QPushButton#settingsButton:checked:hover,
QPushButton#aboutButton:checked:hover {
    background: #24364C;
    color: #F3F5F8;
    font-weight: 600;
}

QPushButton#discoverButton:checked QLabel#navText,
QPushButton#installedButton:checked QLabel#navText,
QPushButton#updatesButton:checked QLabel#navText,
QPushButton#settingsButton:checked QLabel#navText,
QPushButton#aboutButton:checked QLabel#navText {
    color: #F3F5F8;
    font-weight: 600;
}

QLabel#updatesBadge {
    background: #4DA3FF;
    color: #FFFFFF;
    border-radius: 0;
    font-size: 11px;
    font-weight: 700;
}

QFrame#searchFrame {
    background: #262C36;
    border: 1px solid #3A4250;
    border-radius: 0;
}

QFrame#searchFrame[focused="true"] {
    border: 1px solid #4DA3FF;
}

QLineEdit#searchEdit {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: #F3F5F8;
    selection-background-color: #4DA3FF;
    selection-color: #FFFFFF;
}

QLabel#searchIcon {
    background: transparent;
}

QToolButton#searchClearButton {
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 0;
}

QToolButton#searchClearButton:hover {
    background: transparent;
}

QPushButton#searchButton,
QPushButton#primaryButton {
    background: #0F78D4;
    color: #FFFFFF;
    border: none;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
}

QPushButton#searchButton:hover,
QPushButton#primaryButton:hover {
    background: #1A86E0;
}

QPushButton#searchButton:pressed,
QPushButton#primaryButton:pressed {
    background: #0C5EA8;
}

QPushButton#secondaryButton {
    background: #2A3140;
    color: #F3F5F8;
    border: 1px solid #465062;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
}

QPushButton#secondaryButton:hover {
    background: #343C4C;
}

QPushButton#secondaryButton:pressed {
    background: #222833;
}

QLabel#sourceLabel,
QLabel#sortLabel {
    color: #A7B0BE;
    font-size: 12px;
}

QComboBox#sourceCombo,
QComboBox#sortCombo {
    background: #262C36;
    color: #F3F5F8;
    border: 1px solid #3A4250;
    border-radius: 0;
    padding: 0 8px 0 12px;
    min-height: 38px;
    font-size: 14px;
}

QComboBox#sourceCombo:hover,
QComboBox#sortCombo:hover {
    border-color: #516074;
}

QComboBox#sourceCombo:focus,
QComboBox#sortCombo:focus {
    border: 1px solid #4DA3FF;
}

QComboBox#sourceCombo::drop-down,
QComboBox#sortCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    border: none;
    border-radius: 0;
    background: transparent;
}

QComboBox#sourceCombo::down-arrow,
QComboBox#sortCombo::down-arrow {
    image: url(:/icons/chevron-dark.svg);
    width: 12px;
    height: 8px;
}

QListView#comboPopup {
    background: #262C36;
    color: #F3F5F8;
    border: 1px solid #3A4250;
    border-radius: 0;
    outline: 0;
    padding: 4px 0;
}

QListView#comboPopup::item {
    min-height: 32px;
    padding: 6px 12px;
    border: none;
    border-radius: 0;
    color: #F3F5F8;
}

QListView#comboPopup::item:hover {
    background: #313846;
}

QListView#comboPopup::item:selected {
    background: #24364C;
    color: #F3F5F8;
}

QPushButton#filterAllButton,
QPushButton#filterInstalledButton,
QPushButton#filterNotInstalledButton {
    background: #262C36;
    color: #F3F5F8;
    border: 1px solid #3A4250;
    border-radius: 0;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    min-height: 18px;
}

QPushButton#filterAllButton:hover,
QPushButton#filterInstalledButton:hover,
QPushButton#filterNotInstalledButton:hover {
    background: #313846;
}

QPushButton#filterAllButton:checked,
QPushButton#filterInstalledButton:checked,
QPushButton#filterNotInstalledButton:checked,
QPushButton#filterAllButton:checked:hover,
QPushButton#filterInstalledButton:checked:hover,
QPushButton#filterNotInstalledButton:checked:hover {
    background: #0F78D4;
    color: #FFFFFF;
    border: 1px solid #0F78D4;
}

QLabel#emptyStateLabel {
    color: #A7B0BE;
    font-size: 15px;
}

AppCard {
    background: #242A34;
    border: 1px solid #343C48;
    border-radius: 0;
}

AppCard:hover {
    border: 1px solid #465062;
}

AppCard QLabel {
    background: transparent;
    border: none;
}

AppCard QLabel#packageIcon {
    background: #313846;
    border-radius: 0;
}

QLabel#appName,
QLabel#statusBusy {
    color: #F3F5F8;
    font-size: 14px;
    font-weight: 600;
}

QLabel#statusBusy {
    font-size: 13px;
}

QLabel#packageId,
QLabel#statusDetail {
    color: #A7B0BE;
    font-size: 12px;
}

QLabel#statusIcon {
    background: transparent;
    padding: 0;
    margin: 0;
}

QLabel#statusInstalled {
    color: #6CCB5F;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    margin: 0;
}

QLabel#statusUpdate {
    color: #4DA3FF;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    margin: 0;
}

QLabel#statusMuted {
    color: #A7B0BE;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    margin: 0;
}

QLabel#settingsTitle,
QLabel#aboutTitle {
    color: #F3F5F8;
    font-size: 28px;
    font-weight: 700;
}

QLabel#settingsSubtitle,
QLabel#aboutVersion {
    color: #A7B0BE;
    font-size: 14px;
}

QFrame#settingsCard,
QFrame#aboutCard {
    background: #242A34;
    border: 1px solid #343C48;
    border-radius: 0;
}

QLabel#settingsAppearanceHeading,
QLabel#settingsCatalogHeading {
    color: #F3F5F8;
    font-size: 16px;
    font-weight: 600;
}

QLabel#settingsAppearanceBody,
QLabel#settingsCatalogBody,
QLabel#aboutBody {
    color: #C5CDD8;
    font-size: 13px;
}

QScrollArea#appScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollArea#appScrollArea QScrollBar::handle:vertical {
    background: #4C5668;
    border-radius: 0;
    min-height: 32px;
    margin: 0 1px;
}

QScrollArea#appScrollArea QScrollBar::handle:vertical:hover {
    background: #647084;
}

QScrollArea#appScrollArea QScrollBar::add-line:vertical,
QScrollArea#appScrollArea QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
    subcontrol-position: top;
}

QScrollArea#appScrollArea QScrollBar::add-page:vertical,
QScrollArea#appScrollArea QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    height: 0;
}
